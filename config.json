{
  "sync_settings": {
    "polling_interval_seconds": 2.0,
    "pause_timeout_seconds": 30.0,
    "request_timeout_seconds": 5.0,
    "max_retries": 5,
    "backoff_factor": 1.5
  },
  "wallpaper_engine": {
    "custom_executable_path": "",
    "control_wallpaper": true,
