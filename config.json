  },
  "album_color_extraction": {
    "enabled": true,
    "prefer_smallest_thumbnail": true,
    "color_quantization_levels": 8,
    "saturation_boost": true
  },
  "genre_wallpaper_mapping": {
    "rock": "",
    "pop": "",
    "hip hop": "",
    "lo-fi": "",
    "electronic": "",
    "jazz": "",
    "classical": "",
    "phonk": ""
  },
  "logging": {
    "level": "INFO",
    "log_to_file": true,
    "log_file_path": "spotify_we_sync.log",
    "max_file_size_mb": 5,
    "backup_count": 3
  }
